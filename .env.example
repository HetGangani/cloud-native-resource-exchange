# CloudOps Sentinel Environment Configuration Template
FLASK_APP=run.py
FLASK_ENV=development
LOG_LEVEL=INFO

# Security
SECRET_KEY=replace-with-a-32-byte-secret-key-minimum-chars

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resource_exchange
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/test_resource_exchange

# AWS S3 Storage
S3_BUCKET_NAME=cloudops-sentinel-resources-dev
AWS_REGION=us-east-1
# Leave AWS_ENDPOINT_URL blank for real AWS, or set to http://localhost:4566 for LocalStack
AWS_ENDPOINT_URL=

# Simplified Admin Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
